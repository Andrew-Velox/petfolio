{
  "name": "mishi-pet",
  "version": "1.0.1",
  "description": "Drop-in animated desktop pet for any website. Shimeji-style PixiJS companion with auto-pilot, dragging, and 46 animation frames.",
  "type": "module",
  "main": "dist/mishi-pet.cjs",
  "module": "dist/mishi-pet.mjs",
  "browser": "dist/mishi-pet.mjs",
  "exports": {
    ".": {
      "import": "./dist/mishi-pet.mjs",
      "require": "./dist/mishi-pet.cjs",
      "default": "./dist/mishi-pet.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "inline-sprites": "node scripts/inline-sprites.js",
    "prepublishOnly": "npm run inline-sprites && npm run build:lib"
  },
  "keywords": [
    "desktop-pet",
    "shimeji",
    "pixijs",
    "animated",
    "widget",
    "mascot",
    "companion",
    "avatar"
  ],
  "author": "Andrew-Velox <noreply@Andrew-Velox.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrew-Velox/mishi_avt.git"
  },
  "bugs": {
    "url": "https://github.com/Andrew-Velox/mishi_avt/issues"
  },
  "homepage": "https://github.com/Andrew-Velox/mishi_avt#readme",
  "dependencies": {
    "pixi.js": "^6.5.9"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
