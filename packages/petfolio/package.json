{
  "name": "petfolio",
  "version": "2.0.0",
  "description": "Drop-in animated desktop pet for any website. Shimeji-style PixiJS companion with auto-pilot, dragging, and 46 animation frames.",
  "type": "module",
  "main": "dist/petfolio.cjs",
  "module": "dist/petfolio.mjs",
  "browser": "dist/petfolio.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/petfolio.mjs",
      "require": "./dist/petfolio.cjs",
      "default": "./dist/petfolio.mjs"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib && vite build --mode global",
    "preview": "vite preview",
    "inline-sprites": "node scripts/inline-sprites.js",
    "prepublishOnly": "node ../../scripts/sync-package-docs.mjs --readme && npm run inline-sprites && npm run build:lib"
  },
  "keywords": [
    "desktop-pet",
    "shimeji",
    "pixijs",
    "animated",
    "widget",
    "mascot",
    "companion",
    "avatar",
    "petfolio"
  ],
  "author": "Andrew-Velox <noreply@Andrew-Velox.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrew-Velox/petfolio.git"
  },
  "bugs": {
    "url": "https://github.com/Andrew-Velox/petfolio/issues"
  },
  "homepage": "https://github.com/Andrew-Velox/petfolio#readme",
  "devDependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "pixi.js": "^6.5.9",
    "vite": "^5.4.0"
  },
  "unpkg": "dist/petfolio.global.js",
  "jsdelivr": "dist/petfolio.global.js",
  "types": "types/index.d.ts",
  "sideEffects": true
}
