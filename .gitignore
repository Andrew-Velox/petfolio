# ===========================================
# Petfolio monorepo .gitignore
# ===========================================

# ---------- Dependencies (any package) ----------
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build outputs ----------
# Vite library (packages/petfolio)
packages/petfolio/dist/
# Next.js (site/)
.next/
out/
build/
dist/

# ---------- Test / coverage ----------
coverage/
*.lcov
.nyc_output/

# ---------- Env files (NEVER commit secrets) ----------
.env
.env.local
.env.*.local
.env.development
.env.production

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ---------- Editor / OS junk ----------
.DS_Store
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.directory
.trash/

# ---------- TypeScript / build cache ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Vite cache ----------
.vite/
.cache/

# ---------- Petfolio CLI generated artifacts ----------
# Generated by `npx petfolio-cli` — should be regenerated, not committed
**/public/petfolio-knowledgeBase.json
**/public/mishi-knowledge.json

# ---------- OS-specific junk ----------
.DS_Store
desktop.ini
ehthumbs.db
Icon?
$RECYCLE.BIN/

# ---------- Misc ----------
*.tgz
.pnpm-store/
